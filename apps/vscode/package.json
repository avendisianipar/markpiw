{
  "name": "markpiw",
  "displayName": "markpiw",
  "description": "Editor markdown WYSIWYG: edit langsung di preview, file .md tetap bersih untuk git.",
  "version": "0.1.0",
  "publisher": "markpiw-internal",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/avendisianipar/markpiw.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markpiw.editor",
        "displayName": "markpiw",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markpiw.openInMarkpiw",
        "title": "Buka dengan markpiw",
        "category": "markpiw",
        "icon": "$(edit)"
      },
      {
        "command": "markpiw.claimShortcut",
        "title": "Shortcut format markpiw",
        "category": "markpiw"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markpiw.openInMarkpiw",
          "when": "resourceExtname == .md && activeCustomEditorId != markpiw.editor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markpiw.openInMarkpiw",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markpiw.claimShortcut",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "markpiw",
      "properties": {
        "markpiw.assetsFolder": {
          "type": "string",
          "default": "assets",
          "description": "Folder (relatif terhadap file .md) tempat gambar yang ditempel disimpan."
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+b",
        "mac": "cmd+b",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+i",
        "mac": "cmd+i",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+e",
        "mac": "cmd+e",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+k",
        "mac": "cmd+k",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+shift+7",
        "mac": "cmd+shift+7",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+shift+8",
        "mac": "cmd+shift+8",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      },
      {
        "key": "ctrl+shift+9",
        "mac": "cmd+shift+9",
        "command": "markpiw.claimShortcut",
        "when": "activeCustomEditorId == 'markpiw.editor'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build && node notices.mjs",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository -o markpiw.vsix",
    "test:integration": "pnpm build && node test/run.mjs"
  },
  "dependencies": {
    "@markpiw/editor": "workspace:*",
    "@markpiw/host": "workspace:*",
    "@markpiw/markdown": "workspace:*",
    "@markpiw/ui": "workspace:*",
    "@markpiw/vendor-prosemirror": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "~1.95.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.5"
  }
}
