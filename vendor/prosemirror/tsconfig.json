{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".types",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "prosemirror-model": ["./prosemirror-model/src/index.ts"],
      "prosemirror-transform": ["./prosemirror-transform/src/index.ts"],
      "prosemirror-state": ["./prosemirror-state/src/index.ts"],
      "prosemirror-view": ["./prosemirror-view/src/index.ts"],
      "prosemirror-history": ["./prosemirror-history/src/history.ts"],
      "prosemirror-inputrules": ["./prosemirror-inputrules/src/index.ts"],
      "prosemirror-keymap": ["./prosemirror-keymap/src/keymap.ts"],
      "prosemirror-commands": ["./prosemirror-commands/src/commands.ts"],
      "prosemirror-schema-list": ["./prosemirror-schema-list/src/schema-list.ts"],
      "prosemirror-gapcursor": ["./prosemirror-gapcursor/src/index.ts"]
    }
  },
  "include": ["prosemirror-*/src/**/*.ts"]
}
